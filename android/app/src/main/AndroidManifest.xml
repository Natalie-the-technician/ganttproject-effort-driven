<?xml version="1.0" encoding="UTF-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      The only permission the app needs. File access goes through the system
      document picker, which grants access per file and needs no storage
      permission at all - deliberately, so the app can never read anything the
      user did not hand it.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GanttMobile">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Being offered when a .gan file is tapped.

              Three filters, because no single one works everywhere:

              1. By file name. Only usable when the URI actually carries the
                 name, which is true for file:// and for some providers.
                 The repeated patterns are not a mistake: Android's
                 PatternMatcher does not backtrack, so ".*\\.gan" fails on any
                 path that already contains a dot ("/Drive.sync/plan.gan").
                 One pattern per additional dot is the documented workaround.
                 pathSuffix does it properly but exists only from API 31.

              2. By content type. Cloud providers hand over a content:// URI
                 with no file name in the path at all, so filter 1 can never
                 match them; a .gan file is XML, and providers that sniff the
                 content report it as such.

              3. The share sheet, as the fallback that always works: whatever
                 the provider claims a file is, "Share -> GanttProject Mobile"
                 reaches us. Restricted to octet-stream and XML so the app
                 does not clutter the share sheet for photos and messages.
            -->
            <intent-filter android:label="@string/open_with_label">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathSuffix=".gan" />
                <data android:pathPattern=".*\\.gan" />
                <data android:pathPattern=".*\\..*\\.gan" />
                <data android:pathPattern=".*\\..*\\..*\\.gan" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.gan" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\.gan" />
            </intent-filter>

            <intent-filter android:label="@string/open_with_label">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="text/xml" />
                <data android:mimeType="application/xml" />
            </intent-filter>

            <intent-filter android:label="@string/open_with_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="text/xml" />
                <data android:mimeType="application/xml" />
            </intent-filter>
        </activity>
    </application>
</manifest>
